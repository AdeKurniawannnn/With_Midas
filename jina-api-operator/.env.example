# Jina API Configuration
# Copy this file to .env and fill in your actual values

# Jina AI API Key (get from https://jina.ai/api)
JINA_API_KEY=your-api-key-here

# Optional: Cache directory for API responses
JINA_CACHE_DIR=cache

# Optional: Default timeout for API requests (seconds)
JINA_TIMEOUT=30

# Optional: Maximum retry attempts for failed requests
JINA_MAX_RETRIES=3

# Optional: Enable token usage logging
JINA_LOG_TOKENS=true

# Optional: Cache TTL (Time To Live) in seconds
JINA_CACHE_TTL=3600

# Optional: DeepSearch specific settings
JINA_DEEPSEARCH_BUDGET_TOKENS=500000
JINA_DEEPSEARCH_REASONING_EFFORT=medium
JINA_DEEPSEARCH_TEAM_SIZE=2

# Optional: Reader API settings
JINA_READER_TIMEOUT=30
JINA_READER_USE_READERLM_V2=false

# Optional: Embeddings model selection
JINA_EMBEDDINGS_MODEL=jina-embeddings-v4
JINA_EMBEDDINGS_NORMALIZED=true
JINA_EMBEDDINGS_TYPE=float

# Optional: Reranker model selection
JINA_RERANKER_MODEL=jina-reranker-v3

# Optional: Classifier model selection
JINA_CLASSIFIER_MODEL=jina-embeddings-v3
